
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-icat",
    "source": "~/.config/fastfetch/ordis/ordis.gif",
    "width": 20,
    "height": 10,
    "padding": {
      "top": 5,
      "bottom": 0,
      "right": 2,
      "left": 1
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#ADC7FF", // Pastel Blue
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "colors",
      "key": "╭─",
      "paddingLeft": 2,
      "symbol": "circle",
      "block": {
          "range": [0, 7]
      },
      "brightness": "normal"
    },
    {
      "type": "custom",
      "key": "│",
      "format": ""
    },
    {
      "type": "os",
      "key": "├ ",
      "outputColor": "#B5FFE2" // Mint 
    },
    {
      "type": "kernel",
      "key": "├ ",
      "outputColor": "#B5FFE2"
    },
    {
      "type": "shell",
      "key": "├ 󱆃",
      "outputColor": "#B5FFE2"
    },
    {
      "type": "de",
      "key": "├ 󰹑",
      "outputColor": "#B5FFE2"
    },
    {
      "type": "wm",
      "key": "├ 󱂬",
      "outputColor": "#B5FFE2"
    },
    {
      "type": "terminal",
      "key": "├ ",
      "outputColor": "#B5FFE2"
    },
    {
      "type": "host",
      "key": "├ 󰟀",
      "outputColor": "#B5FFE2"
    },
    {
      "type": "cpu",
      "key": "├ ",
      "outputColor": "#B5FFE2"
    },
    {
      "type": "gpu",
      "key": "├ 󱤓",
      "outputColor": "#B5FFE2"
    },
    {
      "type": "memory",
      "key": "├ ",
      "outputColor": "#B5FFE2"
    },
    {
      "type": "disk",
      "key": "├ 󰋊",
      "outputColor": "#B5FFE2"
    },
    {
      "type": "custom",
      "key": "│",
      "format": ""
    },
    {
      "type": "colors",
      "key": "╰─",
      "paddingLeft": 2,
      "symbol": "circle",
      "block": {
          "range": [8, 15]
      },
      "brightness": "light"
    },
    "break",
    "break"
  ]
}
